# Academic Event & Resource Booking Portal - Backend Environment Configuration

# Application Environment (development | production | test)
NODE_ENV=production
PORT=5000

# Database Configuration
MONGO_URI=mongodb://localhost:27017/academic-booking-portal

# Authentication & JWT Secrets
JWT_SECRET=super_secret_jwt_signing_key_replace_in_production_min32chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# CORS & Client Integration
CLIENT_URL=http://localhost:5173

# AI Microservice & Google Gemini Integration
AI_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=your_google_gemini_api_key_here
